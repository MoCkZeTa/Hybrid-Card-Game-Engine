{
  "name": "@hcg/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-games.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@hcg/shared": "*",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "mongodb": "^6.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/ws": "^8.5.12",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
