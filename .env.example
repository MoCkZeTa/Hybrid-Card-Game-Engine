# Copy to .env and fill in real values. NEVER commit .env.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string, including the database name.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cardgame?retryWrites=true&w=majority"

# --- LLM providers --------------------------------------------------------
# Which provider the AI router dispatches to. One of: groq | gemini
LLM_PROVIDER="groq"

# Groq (https://console.groq.com/keys)
# One key per line inside the quotes (commas work too). Requests round-robin
# across the pool, and a key that is rate-limited or revoked is skipped in
# favour of the next one, so N free-tier keys give roughly N times the
# per-minute headroom. A single key is fine — GROQ_API_KEY also still works.
GROQ_API_KEYS="gsk_key_one
gsk_key_two"
# Must be a reasoning-capable Groq model (e.g. the default below, or
# openai/gpt-oss-20b) for the Medium/Hard/Extremely Hard bot levels to work —
# they all reuse this one model and only vary reasoning_effort (see
# createBotTiersFromEnv below). A plain chat model (llama-3.1-8b-instant,
# llama-3.3-70b-versatile, ...) rejects reasoning_effort with a 400 for
# anything above Easy, and every AI turn at those levels silently degrades to
# legal_moves[0] instead of actually reasoning.
GROQ_MODEL="openai/gpt-oss-120b"
# Optional. One of: low | medium | high. Also picks which bot difficulty
# level (Medium/Hard/Extremely Hard respectively) the host's level picker
# preselects when starting a match with empty seats — unset preselects Easy.
# See core/ai/provider-router.ts#createBotTiersFromEnv.
GROQ_REASONING_EFFORT=""

# Gemini — optional, only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- AI game designer -----------------------------------------------------
# The "describe a game, get a plugin" feature (core/authoring/, GAME_DESIGNER.md).
# It reuses whichever provider LLM_PROVIDER selects and the same key pool, so
# there is no extra key to obtain. Unlike everything else here it has no
# degraded mode — authoring a rules.json needs a generative call and there is
# no legal_moves[0] to fall back on — so with no key configured the routes
# report themselves unavailable and the client hides the panel entirely.
#
# Model used for drafting. Separate from GROQ_MODEL on purpose: a game seat
# wants the fastest model that can pick one id out of a list, and drafting a
# hundred-line schema-conformant document wants the most capable model
# available. Defaults to openai/gpt-oss-120b for Groq, gemini-2.0-flash for
# Gemini. Leave unset to take the default.
DESIGNER_MODEL=""

# Reply ceiling for one drafting call. READ THIS BEFORE RAISING IT: Groq
# charges max_tokens against your per-minute token budget UP FRONT, whether or
# not the reply uses it. On a free tier capped at 8000 TPM, the ~4000-token
# prompt plus a large ceiling is refused with a 413 before a single token is
# generated — and switching to groq/compound does not help, because it proxies
# to the same model and shares its budget. So: 8000 on a paid tier, ~3200 if
# you are on a free 8000 TPM key. Below ~2000 the first draft of a session is
# truncated mid-JSON every time. Unset uses the built-in default (8000).
DESIGNER_MAX_TOKENS=""

# Wall-clock budget for one drafting call, in ms. Far longer than any bot-seat
# timeout: a slow AI turn stalls a live table, a slow draft is someone watching
# a spinner having asked for something that takes a while. Default 90000.
DESIGNER_TIMEOUT_MS=""

# --- Transactional email (password reset) ---------------------------------
# Resend API key (https://resend.com/api-keys). Without one, reset links are
# printed to the server console instead of emailed — fine locally, and a
# REFUSAL TO START under NODE_ENV=production unless you also set
# ALLOW_CONSOLE_EMAIL=true to say you meant it. A reset flow that accepts the
# request, stores a token, and mails nobody looks identical to a working one.
RESEND_API_KEY=""

# Sender address. IMPORTANT: the default onboarding@resend.dev only delivers to
# the email address on your own Resend account — every other recipient is
# rejected. It is enough to test the flow end to end and NOT enough to ship.
# Verify a domain at https://resend.com/domains and use an address on it.
EMAIL_FROM="onboarding@resend.dev"

# Set to "true" to boot a production process with no RESEND_API_KEY anyway,
# accepting that password reset does not work. Only meaningful in production.
ALLOW_CONSOLE_EMAIL="false"

# Public origin of the CLIENT — what reset links point at. In a single-origin
# deploy (SERVE_STATIC=true) this is the same URL as the server itself.
APP_BASE_URL="http://localhost:5173"

# --- Redis (optional) -----------------------------------------------------
# Leave REDIS_URL empty to run a single instance with everything in memory —
# that is the normal local-development setup and nothing else has to change.
#
# Set it to run MORE THAN ONE backend instance. Redis then provides:
#   * match ownership leases  — one node owns each live match; other nodes
#                               route commands to it and relay its broadcasts
#   * pub/sub fan-out         — state updates reach players on any instance
#   * shared rate limits      — a per-IP budget that a client cannot dodge by
#                               being load-balanced to a different node
#   * session caching         — cuts two Mongo reads off every WS handshake
#
# NOTE: with NODE_ENV=production, setting REDIS_URL and having Redis be
# unreachable is a hard startup failure. Coming up as an isolated node that
# cannot see the rest of the cluster's matches is worse than not starting.
# Use rediss:// for TLS (most managed providers).
REDIS_URL="rediss://"
REDIS_KEY_PREFIX="hcg"
REDIS_COMMAND_TIMEOUT_MS="3000"

# Used ONLY by core/cluster/redis-integration.test.ts, which is skipped unless
# this is set. That suite is the one that exercises the Lua scripts and the
# ioredis wiring against a real server rather than an in-memory stand-in:
#   cd backend && npx vitest run redis-integration
# It writes under a per-run key prefix and deletes it afterwards, so pointing it
# at a shared database is safe — a throwaway one is still the better idea.
REDIS_TEST_URL=""

# Stable identity for this instance. Optional — a fresh UUID is generated per
# boot. Set it to something meaningful (a pod name) to make logs readable.
NODE_ID=""

# How long a node's claim on a match survives without renewal. If a node dies,
# another can take the match over after this long. Shorter = faster failover,
# more Redis traffic.
MATCH_LEASE_TTL_MS="30000"

# --- Server ---------------------------------------------------------------
PORT="3001"
NODE_ENV="development"

# Comma-separated list. Enforced on the WebSocket upgrade as well as on CORS —
# a browser page from any other origin cannot open a socket. Outside
# production, any http://localhost:<port> is also accepted so Vite's port
# hopping doesn't break local dev.
CORS_ORIGIN="http://localhost:5173"

# Set to "true" ONLY when running behind a load balancer or reverse proxy you
# control. It makes the server believe X-Forwarded-For; anywhere else, a client
# could spoof that header and slip past the per-IP auth rate limit.
TRUST_PROXY="false"

# Serve the built frontend (frontend/dist) from this same process and port.
# Turns the deploy into one process on one origin: no separate frontend host,
# no CORS to configure, and the WebSocket connects back to whatever origin
# served the page. Requires `npm run build` to have run first.
SERVE_STATIC="false"
# Where those built files are. Defaults to ../../frontend/dist relative to the
# compiled server, which is correct for a normal checkout.
FRONTEND_DIST=""

# --- WebSocket tuning -----------------------------------------------------
# Server-side ping interval. A connection that misses one round is treated as
# dead and its seat handed to the AI — so this also sets how long a table waits
# on a player whose laptop lid just closed.
WS_HEARTBEAT_MS="30000"
# Hard cap on simultaneous sockets on this instance. Further upgrades get a 503.
WS_MAX_CONNECTIONS="10000"

# --- Latency budgets (ms) — see PRD section 6 ------------------------------
# NOTE: AI-seat turns during a match no longer use this — their timeout comes
# from the fixed Easy/Medium/Hard/Extremely Hard ladder in
# `core/ai/provider-router.ts#createBotTiersFromEnv` (1500/4000/6300/10000ms).
# LLM_TIMEOUT_MS still governs any other direct `decideTurn` caller.
LLM_TIMEOUT_MS="1200"
TURN_TIMEOUT_MS="1500"

# --- Logging --------------------------------------------------------------
# Every AI decision is logged to the console by default. Set to "false" to
# silence it; "true" on LOG_AI_VERBOSE prints the model's full reasoning
# instead of a truncated line.
LOG_AI="true"
LOG_AI_VERBOSE="false"
